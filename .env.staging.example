# Variables de entorno — STAGING
# Copiar este archivo a .env.staging y completar con valores reales.
# NUNCA commitear .env.staging

# Proyecto Supabase Staging (no producción)
VITE_SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<STAGING_ANON_KEY>

# Flag para identificar el ambiente en logs y UI
VITE_ENVIRONMENT=staging

# Solo para scripts de admin/migración (nunca en frontend)
# SUPABASE_SERVICE_ROLE_KEY=<STAGING_SERVICE_ROLE_KEY>
